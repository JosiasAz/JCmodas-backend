# Copie para .env e ajuste
# Em "production" a API não sobe com chave/senha padrão e esconde o /docs
ENVIRONMENT=development
# Banco: o Postgres do Neon vem do .env.local da raiz (criado pelo `neon deploy`), com
# DATABASE_URL e DATABASE_URL_UNPOOLED. Sem ele, descomente a linha abaixo para usar SQLite.
# DATABASE_URL=sqlite:///./jcmoda.db
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave-por-uma-bem-grande
CORS_ORIGINS=["http://localhost:4200"]
ADMIN_EMAIL=seu-email@exemplo.com
ADMIN_PASSWORD=troque-esta-senha

# "Entrar com Google" no painel (opcional). Crie em console.cloud.google.com > APIs e serviços >
# Credenciais > ID do cliente OAuth (tipo "Aplicativo da Web") e coloque o endereço do site em
# "Origens JavaScript autorizadas". Só entra quem já é administrador com o mesmo e-mail.
GOOGLE_CLIENT_ID=
