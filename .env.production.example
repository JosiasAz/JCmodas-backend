# Configuração de PRODUÇÃO (copie para a VPS como backend/.env; nunca deixe este arquivo no
# repositório com valores reais). Com ENVIRONMENT=production a API:
#   - se recusa a subir com SECRET_KEY curta/padrão ou ADMIN_PASSWORD padrão;
#   - esconde /docs e /openapi.json;
#   - exige verificação em duas etapas para entrar no painel;
#   - envia HSTS.
ENVIRONMENT=production

# Banco (Neon): o app usa um papel SÓ COM DML (jc_app); o dono fica só na conexão direta, para migrações.
DATABASE_URL=postgresql://jc_app:SENHA@HOST-pooler/neondb?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://jc_db_owner:SENHA@HOST/neondb?sslmode=require&channel_binding=require
NEON_BRANCH=production

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Endereço(s) do site na Vercel (sem barra no final). Inclua o domínio próprio, se tiver.
CORS_ORIGINS=["https://jc-moda.vercel.app","https://www.seudominio.com.br"]

# Só para criar o primeiro administrador. Depois do primeiro start, APAGUE a linha ADMIN_PASSWORD.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# "Entrar com Google" no painel (opcional). Crie em console.cloud.google.com > APIs e serviços >
# Credenciais > ID do cliente OAuth (tipo "Aplicativo da Web") e coloque o endereço do site em
# "Origens JavaScript autorizadas". Só entra quem já é administrador com o mesmo e-mail.
GOOGLE_CLIENT_ID=
